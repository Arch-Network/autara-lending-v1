# Autara internal-b deploy env — the internal-b stage (internal-6 / lq fleet).
# Picked by ci-load-env.sh from the arch-deploy contract stage name; the tool
# treats internal-* as testnet-mode chains (config.rs Network parsing).
#
# Key PATHS only — never secrets. CI decodes the internal-b GitHub Environment
# secrets (PROGRAM/ORACLE/DEPLOYER/ADMIN_KEYPAIR_B64) into temp files and
# overrides these paths.
NETWORK=internal-b
ARCH_RPC_URL=https://rpc.internal-b.arch.network
USE_FAUCET=true

PROGRAM_KEY_PATH=autara-deploy/.keys-internal-b/program.json
ORACLE_KEY_PATH=autara-deploy/.keys-internal-b/oracle.json
DEPLOYER_KEY_PATH=autara-deploy/.keys-internal-b/deployer.json
ADMIN_KEY_PATH=autara-deploy/.keys-internal-b/admin.json

PROGRAM_ELF_PATH=target/deploy/autara_program.so
ORACLE_ELF_PATH=target/deploy/autara_oracle.so

PROTOCOL_FEE_SHARE_BPS=5000

# Internal chains carry no aUSD/aBTC mints, so TOKENS / MARKET_PAIRS stay unset:
# deploy, upgrade and initialize work; setup-markets needs mints created first.
LENDING_MARKET_FEE_BPS=100

OUTPUT_PATH=deployments/internal-b.json
