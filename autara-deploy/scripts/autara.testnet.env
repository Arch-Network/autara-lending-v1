# Autara testnet deploy env.
#
# Key PATHS only — never secrets. All keypairs live under the gitignored
# autara-deploy/.keys-testnet/ directory (see docs/key-hygiene.md).
#
# On-chain testnet redeploy with these keys completed 2026-08-14
# (see docs/testnet-deployment.md). Do not point these paths at keys/.
#
# Product market: aUSD/aBTC using the Arch Network APL mints (not the older
# faucet USDC/BTC/ETH mints). Prior USDC/BTC + USDC/ETH markets on this program
# were incorrect for product and should not be treated as the default path.

NETWORK=testnet
ARCH_RPC_URL=https://rpc.testnet.arch.network
USE_FAUCET=true

# autara-program: its pubkey must equal autara_program::id() (the compiled-in id
# used on-chain for global-config PDA derivation + ownership checks).
# After generating a fresh program key, run sync-program-id.sh + rebuild before
# any real deploy (deferred).
PROGRAM_KEY_PATH=autara-deploy/.keys-testnet/program.json
# autara-oracle: position-independent (uses the runtime program_id only).
ORACLE_KEY_PATH=autara-deploy/.keys-testnet/oracle.json
# Program upgrade authority + payer for the ELF uploads.
DEPLOYER_KEY_PATH=autara-deploy/.keys-testnet/deployer.json
# Global-config admin (also payer/signer for create_global_config).
ADMIN_KEY_PATH=autara-deploy/.keys-testnet/admin.json

PROGRAM_ELF_PATH=target/deploy/autara_program.so
ORACLE_ELF_PATH=target/deploy/autara_oracle.so

PROTOCOL_FEE_SHARE_BPS=5000

# Token mints (LABEL:MINT_HEX:DECIMALS). Public addresses — not secrets.
# base58: aUSD=6mqUuwPYehXei6mGBY4bQ6XK1z7e6rrFAZRzYKdH8qkp (decimals 6)
#         aBTC=2yHWVNYyjnsxZqpnvTbPzWiHwpNQ2zBQU6BC4Lnbu7sW (decimals 8)
TOKENS=aUSD:55c6cee38a31732e2dad821ab1c38f902a7c51efaefb3641d51f3485c4617a45:6,aBTC:1d46e0dd87393236e4e01252439f46dcbaec7c2255d1fd734e61771a00e8f4e9:8

# Lending markets to create (SUPPLY/COLLATERAL by label).
MARKET_PAIRS=aUSD/aBTC
LENDING_MARKET_FEE_BPS=100

OUTPUT_PATH=deployments/testnet.json
